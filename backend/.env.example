# Server
PORT=5050
NODE_ENV=development
# Frontend URL(s) allowed to call the API with cookies (comma separated)
CLIENT_URL=http://localhost:5180

# MongoDB - a NEW database just for this project (it is created automatically on first write)
MONGO_URI=mongodb://127.0.0.1:27017/shopkart_trinankur

# JWT - use a long random string
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Razorpay TEST MODE keys (Dashboard -> Test Mode -> Account & Settings -> API Keys)
# The secret stays on the backend only. Never put it in the frontend or commit it.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional - placeholder admin created by `npm run seed:admin` (defaults: admin@shopkart.dev / Admin@123)
# ADMIN_EMAIL=admin@shopkart.dev
# ADMIN_PASSWORD=change_me

# Optional - "Continue with Google" (OAuth 2.0). The button only appears when both are set.
# Authorised redirect URI in Google Cloud: <site>/api/auth/google/callback
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional - public URL of the site; normally worked out from the request
# APP_URL=https://shopkart-sooty.vercel.app
